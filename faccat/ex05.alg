Algoritmo "ex05"
// Professor   : Jailson Costa dos Santos
// Descrição   : Ler um valor e escrever o seu antecessor (valor - 1)
// Autor(a)    : Matheus Coletti
Var
   numero: real

Inicio
   escreval("Informe um numero: ")
   leia(numero)
   
   escreval("O antecessor e: ", numero - 1)
Fimalgoritmo
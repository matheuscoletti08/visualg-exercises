Algoritmo "ex15"
// Professor   : Jailson Costa dos Santos
// Descricao   : Ler um valor e informar se e positivo ou negativo.
// Autor(a)    : Matheus Coletti
Var
   valor: real

Inicio
   escreval("Informe um valor: ")
   leia(valor)
   se (valor >= 0) entao
      escreval("POSITIVO")
   senao
      escreval("NEGATIVO")
   fimse
Fimalgoritmo
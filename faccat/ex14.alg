Algoritmo "ex14"
// Professor   : Jailson Costa dos Santos
// Descricao   : Ler um valor e informar se e maior que 10.
// Autor(a)    : Matheus Coletti
Var
   valor: real

Inicio
   escreval("Informe um valor: ")
   leia(valor)
   se (valor > 10) entao
      escreval("E MAIOR QUE 10!")
   senao
      escreval("NAO E MAIOR QUE 10!")
   fimse
Fimalgoritmo
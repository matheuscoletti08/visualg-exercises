Algoritmo "ex66_B"
// Professor   : Jailson Costa dos Santos
// Descricao   : Tabuada de 1 a 10 de um numero qualquer (usando PARA).
// Autor(a)    : Matheus Coletti
Var
   numero: inteiro
   i: inteiro

Inicio
   escreval("Digite um numero: ")
   leia(numero)
   para i de 1 ate 10 faca
      escreval(numero, " x ", i, " = ", numero * i)
   fimpara
Fimalgoritmo
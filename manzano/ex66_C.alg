Algoritmo "ex66_C"
// Professor   : Jailson Costa dos Santos
// Descricao   : Soma dos 100 primeiros numeros inteiros (1 a 100) - PARA.
// Autor(a)    : Matheus Coletti
Var
   i: inteiro
   soma: inteiro

Inicio
   soma <- 0
   para i de 1 ate 100 faca
      soma <- soma + i
   fimpara
   escreval("Soma de 1 a 100: ", soma)
Fimalgoritmo
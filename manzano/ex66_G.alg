Algoritmo "ex66_G"
// Professor   : Jailson Costa dos Santos
// Descricao   : Potencias de 3 (expoente 0 a 15) - PARA.
// Autor(a)    : Matheus Coletti
Var
   i: inteiro
   resultado: inteiro

Inicio
   para i de 0 ate 15 faca
      resultado <- 3 ^ i
      escreval("3 ^ ", i, " = ", resultado)
   fimpara
Fimalgoritmo
Algoritmo "ex46_D"
// Professor   : Jailson Costa dos Santos
// Descricao   : Apresentar todos os valores inteiros impares de 0 a 20.
// Autor(a)    : Matheus Coletti
Var
   i: inteiro

Inicio
   i <- 0
   enquanto (i <= 20) faca
      se (i % 2 <> 0) entao
         escreval(i)
      fimse
      i <- i + 1
   fimenquanto
Fimalgoritmo